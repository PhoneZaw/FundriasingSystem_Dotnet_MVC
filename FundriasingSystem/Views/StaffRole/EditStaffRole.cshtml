@using FundriasingSystem.Models.StaffRole;
@model EditStaffRoleViewModel

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<form asp-action="EditStaffRole" asp-controller="StaffRole" method="post">

    <input asp-for="Id" hidden />
    <input asp-for="CreatedAt" hidden />

    <div class="mb-3">
        <label asp-for="RoleName" class="form-label">Staff Role Name</label>
        <input type="text" class="form-control" asp-for="RoleName" />
        <span asp-validation-for="RoleName" class="text-danger"></span>
    </div>
    <div class="mb-3">`
        <label class="form-label">Status</label>
        <select asp-for="Status" class="form-control mb-3">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="">
        <button type="submit" class="btn btn-primary">Update</button>
    </div>
</form>