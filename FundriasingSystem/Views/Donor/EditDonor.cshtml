@using FundraisingApp.Enums;
@using FundriasingSystem.Models.Certificate;
@using FundriasingSystem.Models.DonorModels;
@model EditDonorViewModel

@{

    var certificates = ViewData["Certificates"] as List<CertificateViewModel>;
}
<h2 class="ml-5">Donor Profile</h2>

<form asp-action="EditDonor" asp-controller="Donor" method="post">
    
    <input asp-for="Id" hidden/>
    <input asp-for="Status" hidden/>
    <input asp-for="CreatedAt" hidden/>
    <input asp-for="HashPassword" hidden/>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label">First Name</label>
        <input type="text" class="form-control" asp-for="FirstName" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label">Last Name</label>
        <input type="text" class="form-control" asp-for="LastName" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" asp-for="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Address</label>
        <input type="text" class="form-control" asp-for="Address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Phone No</label>
        <input type="number" class="form-control" asp-for="PhoneNo" />
        <span asp-validation-for="PhoneNo" class="text-danger"></span>
    </div>

    <div class="">
        <button type="submit" class="btn btn-primary">Update</button>
    </div>
</form>
<br />
<hr />
<br />
<div class="c-section">
    <h3>Certificates</h3>
    <br />
    <div>
        @foreach (var certificate in certificates)
        {
            <div class="d-flex c-container">
                <img class="c-img" src="/img/@certificate.Campaign.Images?.Split(",").FirstOrDefault()" alt="" />
                <div class="c-desc">
                    <h4>@certificate.Campaign.Title</h4>
                    <div class="donation-container">
                        @foreach (var donation in certificate.Donations)
                        {
                            <p>Donate @donation.DonationAmount MMK on @donation.CreatedAt <span style="color: orange; font-weight: bold">@(donation.IsVerified ? "" : "(Pending)")</span></p>
                        }
                    </div>
                    <div class="c-actions">
                        @if(certificate.TotalAmount > 0)
                        {
                            <button class="btn btn-primary c-btn">View Certificate</button> 
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .c-section {
        margin: 0 auto;
        max-width: 900px;
    }

    .c-container {
        border: 1px solid #ccc;
        padding: 10px;
        margin-bottom: 10px;
    }

    .c-img {
        width: 350px;
        height: 200px;
    }

    .c-desc {
        margin-left: 20px;
    }

    .donation-container p {
        margin: 10px;
    }

    .c-btn {
        margin-left: auto;
        margin-top: 10px;
    }
</style>