@using FundraisingApp.Entities;
@using FundriasingSystem.Entities;
@using FundriasingSystem.Models.SuggestionModels;
@model Campaign

@{
    var suggestions = ViewData["suggestions"] as List<SuggestionViewModel>;

    var donations = ViewData["donations"] as List<Donation>;

    var currentAmount = ViewData["CurrentAmount"];

    var donationCount = ViewData["donationCount"];

    var donateUrl = $"/donations/donate?CampaignId={Model.Id}";

    var remainingAmount = Model.TargetAmount - int.Parse(currentAmount.ToString());

    var images = Model.Images?.Split(",");

    var shareUrl = $"https%3A//localhost%3A44382/campaigns/{Model.Id}";
}
<br />
<div>
    <span class="badge badge-pill badge-primary">@Model.CampaignType.CampaignTypeName</span>
</div>
<h2>Campaign Title - @Model.Title</h2>
<p>End In - @Model.TargetDate.ToString("dd/MM/yyyy")</p>

<div class="row">

    <div class="col col-7">

        <div id="carousel" class="carousel slide" data-ride="carousel">

            <!-- Indicators -->
            <ul class="carousel-indicators">
                <li data-target="#carousel" data-slide-to="0" class="active"></li>
                <li data-target="#carousel" data-slide-to="1"></li>
                <li data-target="#carousel" data-slide-to="2"></li>
            </ul>

            <!-- The slideshow -->
            <div class="carousel-inner">

                @if (!string.IsNullOrWhiteSpace(Model.Images))
                {
                    @for (int i = 0; i < images.Length; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@images[i]" class="d-block w-100" alt="">
                        </div>
                    }
                }
                else
                {
                    <div class="carousel-item active">
                        <img src="" class="d-block w-100" alt="">
                    </div>
                }
            </div>

            <!-- Left and right controls -->
            <a class="carousel-control-prev" href="#carousel" data-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </a>
            <a class="carousel-control-next" href="#carousel" data-slide="next">
                <span class="carousel-control-next-icon"></span>
            </a>

        </div>

        <br />
        <p>@Model.Description</p>
        <br />
        <div class="share-container">
            <h3>Share on Social Media</h3>
            <div class="component-container">
                <div class="">
                    <a class="share-component" href="https://www.facebook.com/sharer/sharer.php?u=@shareUrl" target="_blank">
                        <img class="share-icon" src="/icons/Facebook.png" />
                        <p>Share on Facebook</p>
                    </a>
                </div>
                <div class="">
                    <a class="share-component" href="https://twitter.com/intent/tweet?text=@donateUrl" target="_blank">
                        <img class="share-icon" src="/icons/Twitter.png" />
                        <p>Share on Twitter</p>
                    </a>
                </div>
                <div class="">
                    <button class="share-component" onclick="copyLink()">
                        <img class="share-icon" src="/icons/Link.png" />
                        <p>Copy Campaign URL</p>
                    </button>
                </div>
            </div>
        </div>
        <br />
        <div class="share-container">
            <h3>Suggestions</h3>

            <br />

            @if (User.Identity is not null && User.Identity.IsAuthenticated)
            {
                <form asp-action="CreateSuggestion" asp-controller="Suggestion" class="sug-input row ml-3">
                    <input type="text" value="@User.Claims.FirstOrDefault(c => c.Type == "UserId")?.Value" name="DonorId" hidden />
                    <input type="text" value="@Model.Id" name="CampaignId" hidden />
                    <input class="col col-8 form-control mr-3" type="text" value="" name="Message" placeholder="Suggestions" />
                    <input class="col col-3 btn btn-primary" type="submit" value="Submit" />
                </form>
            }

            <br />
            <div>   
                @foreach(var suggestion in suggestions)
                {
                    
                    <div class="d-flex">
                        <img src="/icons/heart.svg" alt="avatar" width="40px" height="40px" />
                        <div class="pl-2">
                            <h3 style="font-size: 16px">@suggestion.Donor.GetFullName()</h3>
                            <div class="d-flex align-items-center" style="font-size: 14px">
                                <p style="margin-bottom: 0">
                                    @suggestion.TotalDonationAmount MMK
                                </p>
                                <div style="background-color: grey; width: 4px; height: 5px; border-radius: 100%" class="ml-2"></div>
                                <time class="pl-2">
                                    @suggestion.TimeDiff
                                </time>
                            </div>

                            <div style="font-size: 16px; margin-top: 8px">
                                @suggestion.Message
                            </div>
                        </div>
                    </div>

                }
            </div>
        </div>
        </div>

    <div class="col col-5 campaign-summary">
        <div>
            <p><span class="font-weight-bold">@(currentAmount ?? 0)</span> MMK raised of <span class="font-weight-bold">@Model.TargetAmount</span> MMK</p>

            <div class="progress">
                <div class="progress-bar" role="progressbar" style="width: @((Convert.ToDecimal(currentAmount) / Convert.ToDecimal(Model.TargetAmount)) * 100)%"
                     aria-valuenow="@currentAmount" aria-valuemin="0" aria-valuemax="@Model.TargetAmount"></div>
            </div>
            <div class="row justify-content-between mt-2 mx-3">
                <span>@donationCount donations</span>
                <span>@remainingAmount to go</span>
            </div>
            <br />
            <div class="donations">
                @foreach(var donation in donations)
                {
                    <p style="font-size: small"><b>@donation.Donor?.GetFullName()</b> donate <b>@donation.DonationAmount MMK</b></p>
                }
            </div>

            <hr />

            <div class="mx-2">
                <div class="row justify-content-between">
                    <p>Donate 1000 MMK</p>
                    <a href="@donateUrl&&DonationAmount=1000" class="btn btn-primary donate-btn">Donate</a>
                </div>
                <br />
                <div class="row justify-content-between">
                    <p>Donate 5000 MMK</p>
                    <a href="@donateUrl&&DonationAmount=5000" class="btn btn-primary donate-btn">Donate</a>
                </div>
                <br />
                <div class="row justify-content-between">
                    <p>Donate 10,000 MMK</p>
                    <a href="@donateUrl&&DonationAmount=10000" class="btn btn-primary donate-btn">Donate</a>
                </div>
                <br />
                <div class="row justify-content-between">
                    <p>Donate 100,000 MMK</p>
                    <a href="@donateUrl&&DonationAmount=100000" class="btn btn-primary donate-btn">Donate</a>
                </div>
                <br />
                <div class="row justify-content-between align-items-center flex-nowrap">
                    <div class=" w-auto">
                        Donate <input type="number" id="customAmount" placeholder="Enter Amount" class="py-0 w-50" min="1000" value="1000" />
                    </div>
                    <a href="#" onclick="donateCustomAmount()" class="btn btn-primary donate-btn">Donate</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .donations > * {
        margin: 0;
    }
    .suggestion {
        background-color: #f5f5f5;
        border-radius: 5px;
        padding: 20px;
        height: fit-content;
        width: 100%;
    }

    .sug-input {
        width: 100%;
    }

    .share-container {
        background-color: #f5f5f5;
        border-radius: 5px;
        padding: 20px;
        height: fit-content;
        width: 100%;
    }

    .component-container {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
    }

    .share-component {
        background: #3b5998;
        color: white;
        padding: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .share-component:hover {
            text-decoration: none;
            color: white;
        }

        .share-component p {
            margin: 0;
            padding: 0;
            margin-left: 10px;
            font-size: 14px;
        }

    .share-icon {
        width: 40px;
        height: 40px;
    }

    .campaign-summary {
        background-color: #f5f5f5;
        border-radius: 5px;
        padding: 30px;
        height: fit-content;
    }
</style>

<script>
    function donateCustomAmount() {
        var customAmount = document.getElementById('customAmount').value;

        if (customAmount.trim() !== "") {
            var customUrl = "@donateUrl&&DonationAmount=" + encodeURIComponent(customAmount);

            window.location.href = customUrl;
        } else {
            alert("Please enter a valid donation amount.");
        }
    }

    function copyLink() {
        console.log("Hello");
        navigator.clipboard.writeText("@shareUrl");

        alert("Copied the text: " + "@shareUrl");
    }
</script>
