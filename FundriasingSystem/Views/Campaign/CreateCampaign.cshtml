@using FundriasingSystem.Models.Campaign;
@model CreateCampaignViewModel

@{
}

<form asp-action="CreateCampaign" asp-controller="Campaign" method="post" enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Title</label>
        <input type="text" class="form-control" asp-for="Title" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <input type="text" class="form-control" asp-for="Description" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TargetAmount" class="form-label">TargetAmount</label>
        <input type="number" class="form-control" asp-for="TargetAmount" />
        <span asp-validation-for="TargetAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TargetDate" class="form-label">TargetDate</label>
        <input class="form-control" asp-for="TargetDate" />
        <span asp-validation-for="TargetDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ImageFiles" class="form-label">Images</label>
        <input class="form-control" asp-for="ImageFiles" multiple />
        <span asp-validation-for="ImageFiles" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CampaignTypeId" class="form-label">Campaign Type</label>
        <select asp-for="CampaignTypeId" asp-items="@Model.CampaignTypes" class="form-control mb-3">
            <option value="">Please Select Option</option>
        </select>
        <span asp-validation-for="CampaignTypeId" class="text-danger"></span>
    </div>

    <div class="">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>