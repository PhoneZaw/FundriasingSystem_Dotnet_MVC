@using FundraisingApp.Entities;
@model IEnumerable<Campaign>

<div class="mx-auto">

    <h3 class="text-center">All Campaigns</h3>
    <br />
    <div class="col g-4">
        <p class="text-center"><b>@Model.Count() Campaigns </b> Found</p>
        @if (Model is not null)
        {
            @foreach (var campaign in Model)
            {
                <a href="/campaigns/@campaign.Id" class="card mb-2 mx-auto" style="max-width: 800px;">
                    <div class="row g-0">
                        <div class="col-4 px-0">
                            <img src="@campaign.Images" class="cardImg">
                        </div>
                        <div class="col-8">
                            <div class="card-body">
                                <span class="badge badge-pill badge-primary">
                                    @campaign.CampaignType.CampaignTypeName
                                </span>
                                <h5 class="card-title">@campaign.Title</h5>
                                <div>
                                    <p><span class="font-weight-bold">@(campaign.Description ?? "0")</span> MMK raised of <span class="font-weight-bold">@campaign.TargetAmount</span> MMK</p>

                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @((Convert.ToDecimal(campaign.Description) / Convert.ToDecimal(campaign.TargetAmount)) * 100)%"
                                             aria-valuenow="@campaign.Description" aria-valuemin="0" aria-valuemax="@campaign.TargetAmount"></div>
                                    </div>
                                </div>
                                <p class="card-text">
                                    End In - @campaign.TargetDate
                                </p>
                                <button class="btn btn-primary ml-auto w-100 donate-btn">Donate</button>
                            </div>
                        </div>
                    </div>
                </a>
                <br />
            }
        }
    </div>

</div>

<style>
    a {
        text-decoration: none;
        color: black;
    }
    a:hover {
        text-decoration: none;
        color: black;
    }
    .cardImg {
        height: 100%;
        max-width: 100%;
        object-fit: cover;
    }
</style>