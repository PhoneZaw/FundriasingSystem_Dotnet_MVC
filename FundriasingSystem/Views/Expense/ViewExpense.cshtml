@using FundraisingApp.Entities;
@using FundraisingApp.Enums;
@using FundriasingSystem.Entities;
@model IEnumerable<Expense>

@{
    ViewData["Title"] = "Expense";

    var campaignList = ViewData["CampaignList"] as List<Campaign>;

    var CampaignId = ViewData["CampaignId"];

    Layout = "~/Views/Shared/_StaffLayout.cshtml";

    var totalExpenses = Model.Sum(e => e.Amount);

    var totalDonationAmount = ViewData["totalDonationAmount"] as int? ?? 0;

    var campaignTargetAmount = ViewData["campaignTargetAmount"] as int? ?? 0;

    var actualBudgetLeft = totalDonationAmount - totalExpenses;

    var expectedBudgetLeft = campaignTargetAmount - totalExpenses;
}

<h2>Manage Expense</h2>
<div class="row justify-content-between align-items-center">
    <div class="">
        <label class="col-form-label ml-3"><b>Campaign</b></label>
        <select id="campaignSelect" class="form-control ml-3 font-weight-bolder" style="min-width: fit-content">
            @foreach (var campaign in campaignList)
            {
                <option value="@campaign.Id">@campaign.Title</option>
            })
        </select>
    </div>
    <br />

    <a href="/admin/Expenses/create?CampaignId=@CampaignId" class="btn btn-primary ">Add Expense</a>
</div>


<div class="table-responsive">

    <table class="table table-hover table-borderless">
        <thead>
            <tr>
                <th>Title</th>
                <th>Expense Type</th>
                <th>Amount (MMK)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @if (Model is not null && Model.Any())
            {
                @foreach (var Expense in Model)
                {
                    <tr>
                        <td>
                            <p class="mb-0">@Expense.Title</p>
                            <p class="small text-black-50 mb-1">@Expense.Description</p>
                        </td>
                        <td>
                            @Expense.ExpenseType.ExpenseTypeName
                        </td>
                        <td>
                            <b style="color:darkred;">
                                @Expense.Amount
                            </b>
                        </td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Actions">
                                <a href="/admin/Expenses/edit/@Expense.Id" class="btn btn-primary active">Edit</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
            <tr>
                <td>
                    <p>No Record</p>
                </td>
                    <td></td>
                    <td></td>
                    <td></td>
            </tr>
            }
            <tr class="border-top border-dark">
                <td>
                    <b>Total Expenses</b>
                </td>
                <td></td>
                <td>
                    <b style="color:darkred;">@totalExpenses</b>
                </td>
                <td></td>
            </tr>
            <tr>
                <td>
                    <b>Received Amount</b>
                </td>
                <td>Income</td>
                <td>
                    <b style="color:green;">
                        @totalDonationAmount
                    </b>
                </td>
                <td></td>
            </tr>
            <tr>
                <td>
                    <b>Current Budget Left</b>
                </td>
                <td></td>
                <td>
                    @actualBudgetLeft
                </td>
                <td></td>
            </tr>
            <tr>
                <td>
                    <b>Target Amount</b>
                </td>
                <td>Income</td>
                <td>
                    <b style="color:green;">
                        @campaignTargetAmount

                    </b>
                </td>
                <td></td>
            </tr>
            <tr>
                <td>
                    <b>Expected Budget Left</b>
                </td>
                <td></td>
                <td>
                    @expectedBudgetLeft
                </td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>

<style>
    #campaignSelect,
    #campaignSelect:focus {
        width: 200px;
    }
</style>


@section Scripts{
    <script>
        $(document).ready(function () {
            $("#campaignSelect").change(function () {
                var selectedCampaignId = $(this).val();

                window.location.href = '/admin/expenses?campaignId=' + selectedCampaignId;
            });
        });
    </script>
}