@using FundraisingApp.Enums;
@using FundriasingSystem.Entities;
@model IEnumerable<Expense>

@{
    ViewData["Title"] = "Expense";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}


<h2>Expense List</h2>

<a href="/Expense/CreateExpense" class="btn btn-primary">Create Expense</a>
<div class="table-responsive">


    <table class="table table-hover table-borderless">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Amount</th>
                <th>ExpenseType</th>
                <th>Campaign</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @if (Model is not null && Model.Any())
            {
                @foreach (var Expense in Model)
                {
                    <tr>
                        <td>
                            @Expense.Title
                        </td>
                        <td>
                            @Expense.Description
                        </td>
                        <td>
                            @Expense.Amount
                        </td>
                        <td>
                            @Expense.ExpenseType.ExpenseTypeName
                        </td>
                        <td>
                            @Expense.Campaign.Title
                        </td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Actions">
                                <a href="/Expense/editExpense/@Expense.Id" class="btn btn-primary active">Edit</a>

                                @if (Expense.Status == StatusEnum.Active.ToString())
                                {
                                    <a href="/Expense/Deactivate/@Expense.Id" class="btn btn-danger">Deactivate</a>
                                }
                                else
                                {
                                    <a href="/Expense/Activate/@Expense.Id" class="btn btn-danger">Activate</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>No Data</tr>
            }

        </tbody>
    </table>
</div>
