@using FundraisingApp.Enums;
@using FundriasingSystem.Entities;
@model IEnumerable<ExpenseType>

@{
    ViewData["Title"] = "ExpenseType";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}


<h2>ExpenseType List</h2>

<a href="/admin/ExpenseTypes/create" class="btn btn-primary">Create ExpenseType</a>
<div class="table-responsive">


    <table class="table table-hover table-borderless">
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @if (Model is not null && Model.Any())
            {
                @foreach (var ExpenseType in Model)
                {
                    <tr>
                        <td>
                            @ExpenseType.ExpenseTypeName
                        </td>
                        <td>
                            @ExpenseType.Status
                        </td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Actions">
                                <a href="/admin/ExpenseType/edit/@ExpenseType.Id" class="btn btn-primary active">Edit</a>

                                @if (ExpenseType.Status == StatusEnum.Active.ToString())
                                {
                                    <a href="/admin/ExpenseTypes/Deactivate/@ExpenseType.Id" class="btn btn-danger">Deactivate</a>
                                }
                                else
                                {
                                    <a href="/admin/ExpenseTypes/Activate/@ExpenseType.Id" class="btn btn-danger">Activate</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>No Data</tr>
            }

        </tbody>
    </table>
</div>
