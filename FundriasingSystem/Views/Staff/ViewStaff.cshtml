@using FundraisingApp.Entities;
@using FundraisingApp.Enums;
@model IEnumerable<Staff>

@{
    ViewData["Title"] = "Home Page";

    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}


<h2>Staff List</h2>

    <a href="/admin/staff/create" class="btn btn-primary">Create Staff</a>
<div class="table-responsive">


    <table class="table table-hover table-borderless">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Address</th>
                <th>PhoneNo</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @if (Model is not null && Model.Any())
            {
                @foreach (var staff in Model)
                {
                    <tr>
                        <td>
                            @staff.FirstName @staff.LastName
                        </td>
                        <td>
                            @staff.Email
                        </td>
                        <td>
                            @staff.Address
                        </td>
                        <td>
                            @staff.PhoneNo
                        </td>
                        <td>
                            @staff.Role.RoleName
                        </td>
                        <td>
                            @staff.Status
                        </td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Actions">
                                    <a href="/admin/Staff/edit/@staff.Id" class="btn btn-primary active">Edit</a>

                                @if (staff.Status == StatusEnum.Active.ToString())
                                {
                                    <a href="/admin/Staff/Deactivate/@staff.Id" class="btn btn-danger">Deactivate</a>
                                }
                                else
                                {
                                    <a href ="/admin/Staff/Activate/@staff.Id" class="btn btn-danger">Activate</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>No Data</tr>
            }

        </tbody>
    </table>
</div>
