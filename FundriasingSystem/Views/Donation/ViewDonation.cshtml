@using FundraisingApp.Entities;
@using FundraisingApp.Enums;
@model IEnumerable<Donation>

@{
    ViewData["Title"] = "Donation";
}


<h2>Donation List</h2>

<div class="table-responsive">

    <table class="table table-hover table-borderless">
        <thead>
            <tr>
                <th>Campaign</th>
                <th>Donor</th>
                <th>DonationAmount</th>
                <th>PaymentMethod</th>
                <th>Remark</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @if (Model is not null && Model.Any())
            {
                @foreach (var Donation in Model)
                {
                    <tr>
                        <td>
                            @Donation.Campaign.Title
                        </td>
                        <td>
                            @Donation.Donor.FirstName @Donation.Donor.LastName
                        </td>
                        <td>
                            @Donation.DonationAmount
                        </td>
                        <td>
                            @Donation.PaymentMethod.PaymentMethodName
                        </td>
                        <td>
                            @Donation.Remark
                        </td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Actions">
                                @if(Donation.IsVerified == false)
                                {
                                    <button class="btn btn-primary active" onclick="OpenModal('@Donation.Id.ToString()','@Donation.PaymentVoucherUrl', '@Donation.IsVerified')">Verify</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary active" onclick="OpenModal('@Donation.PaymentVoucherUrl',  '@Donation.IsVerified')">Voucher</button>
                                }
                                </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>No Data</tr>
            }

        </tbody>
    </table>
</div>

<div class="modal fade" id="paymentVoucherModal" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Payment Voucher</h5>
                <button type="button" class="close" onclick="CloseModal()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <img id="voucherImg" src="" class="img-fluid rounded-start">
            </div>
            <div class="modal-footer">
            
                <a href="#" class="btn btn-primary" id="verify_btn">Verify</a>
            </div>
        </div>
    </div>
</div>



@section Scripts
    {
    <script>
        function OpenModal(donationId, paymentVoucherUrl, isVerified){
            $('#paymentVoucherModal #voucherImg').attr('src', `/img/${paymentVoucherUrl}`);
            if (isVerified == "True"){
                $('#paymentVoucherModal #verify_btn').hide();
            }else{
                $('#paymentVoucherModal #verify_btn').attr('href', `/donation/Verify/${donationId}`);

            }
            $("#paymentVoucherModal").modal("show");
        }

        function CloseModal(){
            $("#paymentVoucherModal").modal("hide");
        }
    </script>
}