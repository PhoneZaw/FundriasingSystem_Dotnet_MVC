@model Guid?

@{
    var certificateId = Model;
}

<div class="modal fade show" id="postDonationModal" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Thank You</h5>
                <button type="button" class="close" onclick="CloseModal()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @if (certificateId is null)
                {
                    <p>Thank you for your donation. Please wait for the admin to verify your donation.</p>
                }
                else
                {
                    <p>Thank you for your donation.</p>
                }
            </div>
            <div class="modal-footer">
                @if (certificateId is not null)
                {
                    <a href="/certificates/@certificateId" class="btn btn-success" id="verify_btn">Get Certificate</a>
                }
                <a href="/" class="btn btn-primary" id="verify_btn">Go Home</a>
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $("#postDonationModal").modal("show");
        });
    </script>
}
