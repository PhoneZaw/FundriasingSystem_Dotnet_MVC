@using FundraisingApp.Entities;
@using FundraisingApp.Enums;
@model IEnumerable<CampaignType>

@{
    ViewData["Title"] = "CampaignType";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}


<h2>CampaignType List</h2>

<a href="/admin/CampaignTypes/create" class="btn btn-primary">Create CampaignType</a>
<div class="table-responsive">


    <table class="table table-hover table-borderless">
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @if (Model is not null && Model.Any())
            {
                @foreach (var CampaignType in Model)
                {
                    <tr>
                        <td>
                            @CampaignType.CampaignTypeName
                        </td>
                        <td>
                            @CampaignType.Status
                        </td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Actions">
                                <a href="/admin/CampaignTypes/edit/@CampaignType.Id" class="btn btn-primary active">Edit</a>

                                @if (CampaignType.Status == StatusEnum.Active.ToString())
                                {
                                    <a href="/admin/CampaignTypes/Deactivate/@CampaignType.Id" class="btn btn-danger">Deactivate</a>
                                }
                                else
                                {
                                    <a href="/admin/CampaignTypes/Activate/@CampaignType.Id" class="btn btn-danger">Activate</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>No Data</tr>
            }

        </tbody>
    </table>
</div>
