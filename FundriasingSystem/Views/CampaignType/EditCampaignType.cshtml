@using FundriasingSystem.Models.CampaignType;
@model EditCampaignTypeViewModel

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<h2>Edit Campaign Type</h2>
<br />

<form asp-action="EditCampaignType" asp-controller="CampaignType" method="post">
    
    <input asp-for="Id" hidden/>
    <input asp-for="CreatedAt" hidden/>

    <div class="mb-3">
        <label asp-for="CampaignTypeName" class="form-label">CampaignType Name</label>
        <input type="text" class="form-control" asp-for="CampaignTypeName" />
        <span asp-validation-for="CampaignTypeName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Status</label>
        <select asp-for="Status" class="form-control mb-3">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="">
        <button type="submit" class="btn btn-primary">Update</button>
    </div>
</form>