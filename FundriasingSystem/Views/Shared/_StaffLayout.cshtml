<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FundriasingSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="page" style="display:flex;">
        <div class="sidebar bg-dark" style="flex: 0 0 300px; min-height: 100vh; color: white;">
            <div class="top-row pl-4 navbar" style="background-color: #222; color: white; font-weight: bold;">
                <a class="navbar-brand" href="">Fundraising System</a>
            </div>
            <div>
                <ul class="nav flex-column">
                    <li class="nav-item px-3">
                        <a class="nav-link" href="/admin/staffroles">
                            <span class="oi oi-plus" aria-hidden="true"></span> Staff Roles
                        </a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link" href="/admin/staff">
                            <span class="oi oi-list-rich" aria-hidden="true"></span> Staff
                        </a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link" href="/admin/donors">
                            <span class="oi oi-list-rich" aria-hidden="true"></span> Donors
                        </a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link" href="/admin/campaigntypes">
                            <span class="oi oi-list-rich" aria-hidden="true"></span> CampaignTypes
                        </a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link" href="/admin/campaigns">
                            <span class="oi oi-list-rich" aria-hidden="true"></span> Campaigns
                        </a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link" href="/admin/paymentmethods">
                            <span class="oi oi-list-rich" aria-hidden="true"></span> PaymentMethods
                        </a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link" href="/admin/donations">
                            <span class="oi oi-list-rich" aria-hidden="true"></span> Donations
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="main" style="flex: auto;">

            <div class="content px-4 pt-4">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
