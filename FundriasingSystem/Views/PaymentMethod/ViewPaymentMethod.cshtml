@using FundraisingApp.Entities;
@using FundraisingApp.Enums;
@model IEnumerable<PaymentMethod>

@{
    ViewData["Title"] = "PaymentMethod";
}


<h2>PaymentMethod List</h2>

    <a href="/PaymentMethod/CreatePaymentMethod" class="btn btn-primary">Create PaymentMethod</a>
<div class="table-responsive">


    <table class="table table-hover table-borderless">
        <thead>
            <tr>
                <th>Name</th>
                <th>IsVerificationRequired</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @if (Model is not null && Model.Any())
            {
                @foreach (var PaymentMethod in Model)
                {
                    <tr>
                        <td>
                            @PaymentMethod.PaymentMethodName
                        </td>
                        <td>
                            @PaymentMethod.IsVerificationRequired
                        </td>
                        <td>
                            @PaymentMethod.Status
                        </td>
                        <td>
                            <div class="btn-group" role="group" aria-label="Actions">
                                <a href="/PaymentMethod/editPaymentMethod/@PaymentMethod.Id" class="btn btn-primary active">Edit</a>

                                @if (PaymentMethod.Status == StatusEnum.Active.ToString())
                                {
                                    <a href="/PaymentMethod/Deactivate/@PaymentMethod.Id" class="btn btn-danger">Deactivate</a>
                                }
                                else
                                {
                                    <a href="/PaymentMethod/Activate/@PaymentMethod.Id" class="btn btn-danger">Activate</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>No Data</tr>
            }

        </tbody>
    </table>
</div>
