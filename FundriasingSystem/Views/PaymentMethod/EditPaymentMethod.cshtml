@using FundriasingSystem.Models.PaymentMethod;
@model EditPaymentMethodViewModel

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<form asp-action="EditPaymentMethod" asp-controller="PaymentMethod" method="post">

    <input asp-for="Id" hidden />
    <input asp-for="CreatedAt" hidden />
    <input asp-for="PaymentMethodIconUrl" hidden />

    <div class="mb-3">
        <label asp-for="PaymentMethodName" class="form-label">PaymentMethod Name</label>
        <input type="text" class="form-control" asp-for="PaymentMethodName" />
        <span asp-validation-for="PaymentMethodName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <input asp-for="IsVerificationRequired" />
        <label asp-for="IsVerificationRequired" class="form-label">VerificationRequired</label>
        <span asp-validation-for="IsVerificationRequired" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Status</label>
        <select asp-for="Status" class="form-control mb-3">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="">
        <button type="submit" class="btn btn-primary">Update</button>
    </div>
</form>