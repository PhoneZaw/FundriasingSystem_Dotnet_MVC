@using FundriasingSystem.Entities;
@model Certificate

<h2>Check Certificate</h2>
<br />

<form asp-action="ValidateCertificate" asp-controller="Certificate" method="post">

    <div class="mb-3">
        <label asp-for="Id" class="form-label">Certificate Id</label>
        <input type="text" class="form-control" asp-for="Id" placeholder="Enter Certificate Id" />
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>

    <div class="">
        <button type="submit" class="btn btn-primary">Check</button>
    </div>
</form>